# Machine-local Docker Compose overrides.
#
# Copy this file to `.env` (gitignored) and uncomment + tweak any value.
# Docker Compose auto-loads .env from the directory where `docker compose`
# runs — bin/arca and bin/test both cd to the repo root, so that's here.
#
# The values in this file feed ${VAR:-default} interpolation in the
# docker/docker-compose*.yml files. Unset vars fall back to the defaults
# baked into the compose files — so you can leave this empty if the
# defaults work for your machine.

# ---- Host-side port mappings ----
# Change these if something else on your machine already listens on 9000 / 9080 / 9001.
# ARCA_HOST_PORT=9000
# CONSOLE_HOST_PORT=9080
# ARCA_REPLICA_HOST_PORT=9001

# If you remap ARCA_HOST_PORT, set ARCA_CONSOLE_ENDPOINT too so the console
# knows where the browser should talk to Arca. Use http://localhost:<port>
# for a non-proxied setup, or a full reverse-proxy URL.
# ARCA_CONSOLE_ENDPOINT=http://localhost:9000

# ---- Log level ----
# Any tracing-subscriber filter works: `debug`, `info`, `warn`, or a compound
# spec like `arca=debug,tower=warn,hyper=info`.
# ARCA_LOG=info

# ---- Root credentials (generated on first start if empty) ----
# Override the default SigV4 credentials for local development. Do NOT put
# production credentials in this file — it lives on disk in plaintext.
# ARCA_ROOT_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# ARCA_ROOT_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ---- Build target ----
# Flip to `development` to get the dev image (bash + /bin/arca on PATH).
# Equivalent to `bin/arca start --dev`.
# BUILD_TARGET=production
