#!/usr/bin/env bash
set -euo pipefail

# Run Ceph s3-tests against a clean Arca instance with encryption enabled.
#
# By default, this script:
#   1. Stops any running Arca instance
#   2. Deletes the data volume for clean state
#   3. Rebuilds and starts Arca with --encryption (required for SSE-C/KMS tests)
#   4. Runs the full Ceph s3-test suite
#   5. Generates reports and updates the passlist
#   6. Restores Arca to its previous state (stop the test instance)
#
# Usage:
#   bin/s3-tests                          Run full suite with clean state
#   bin/s3-tests --build                  Rebuild all images first
#   bin/s3-tests --no-clean               Skip clean state setup (use running Arca as-is)
#   bin/s3-tests --passlist               Run only pass-listed tests
#   bin/s3-tests -- -k bucket_list        Filter by name

cd "$(git rev-parse --show-toplevel)"

COMPOSE="docker compose -f docker/docker-compose.yml --profile s3-tests"
PASSLIST="s3-tests/passlist.txt"
BUILD=false
PASSLIST_MODE=false
NO_CLEAN=false
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build)
            BUILD=true
            shift
            ;;
        --passlist)
            PASSLIST_MODE=true
            shift
            ;;
        --no-clean)
            NO_CLEAN=true
            shift
            ;;
        -h|--help)
            echo "Usage: bin/s3-tests [--build] [--no-clean] [--passlist] [-- <pytest args>]"
            echo ""
            echo "Options:"
            echo "  --build     Rebuild all images (arca + s3-tests) first"
            echo "  --no-clean  Skip clean state setup, use running Arca as-is"
            echo "  --passlist  Run only tests listed in s3-tests/passlist.txt"
            echo "  -- <args>   Pass extra arguments to pytest"
            exit 0
            ;;
        --)
            shift
            EXTRA_ARGS+=("$@")
            break
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

# Clean state: stop Arca, wipe volume, restart with encryption
if ! $NO_CLEAN; then
    echo "==> Preparing clean state for s3-tests..."
    bin/arca stop 2>/dev/null || true
    # Delete data volume for clean state
    docker volume rm docker_arca-data 2>/dev/null || true
    echo "==> Starting Arca with --encryption for s3-tests..."
    if $BUILD; then
        bin/arca start -d --build --encryption
    else
        bin/arca start -d --encryption
    fi
    # Wait for Arca to be ready
    echo "==> Waiting for Arca to be ready..."
    for i in $(seq 1 30); do
        if curl -sf http://localhost:9000/ >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done
fi

if $BUILD; then
    echo "==> Building s3-tests image..."
    $COMPOSE build s3-tests
fi

# Build pytest arguments
PYTEST_ARGS=("s3tests/functional/test_s3.py" "-v" "--tb=short" "--timeout=30")
PYTEST_ARGS+=("--junitxml=/s3-tests/output/results.xml")

if $PASSLIST_MODE; then
    if [[ ! -f "$PASSLIST" ]]; then
        echo "Error: passlist not found at $PASSLIST" >&2
        exit 1
    fi
    # Build a -k expression using exact test names joined with "or".
    # Wrap each name in parentheses to avoid substring matches.
    EXPR=""
    while IFS= read -r line; do
        line="${line%%#*}"       # strip comments
        line="$(echo "$line" | tr -d '[:space:]')"
        [[ -z "$line" ]] && continue
        if [[ -z "$EXPR" ]]; then
            EXPR="$line"
        else
            EXPR="$EXPR or $line"
        fi
    done < "$PASSLIST"

    if [[ -z "$EXPR" ]]; then
        echo "Error: passlist is empty" >&2
        exit 1
    fi
    PYTEST_ARGS+=("-k" "$EXPR")
fi

PYTEST_ARGS+=("${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}")

# Split test run: non-Object-Lock tests first, then wipe and run Object Lock tests.
# This prevents COMPLIANCE-locked buckets from cascading failures into unrelated tests.
OBJECT_LOCK_FILTER="test_object_lock"

if ! $PASSLIST_MODE && [[ ${#EXTRA_ARGS[@]} -eq 0 ]] && ! $NO_CLEAN; then
    echo "==> Phase 1: Running non-Object-Lock tests..."
    EXIT_CODE=0
    PHASE1_ARGS=("${PYTEST_ARGS[@]}" "-k" "not $OBJECT_LOCK_FILTER"
        "--junitxml=/s3-tests/output/results_phase1.xml" "--override-ini=junit_suite_name=phase1")
    # Remove the default junitxml (we override it per phase)
    PHASE1_ARGS=("s3tests/functional/test_s3.py" "-v" "--tb=short" "--timeout=30"
        "--junitxml=/s3-tests/output/results_phase1.xml" "-k" "not $OBJECT_LOCK_FILTER")
    $COMPOSE run --rm s3-tests "${PHASE1_ARGS[@]}" || EXIT_CODE=$?

    echo ""
    echo "==> Wiping storage between test phases..."
    bin/arca stop 2>/dev/null || true
    docker volume rm docker_arca-data 2>/dev/null || true
    bin/arca start -d --encryption
    echo "==> Waiting for Arca to be ready..."
    for i in $(seq 1 30); do
        if curl -sf http://localhost:9000/ >/dev/null 2>&1; then break; fi
        sleep 1
    done

    echo ""
    echo "==> Phase 2: Running Object Lock tests..."
    PHASE2_ARGS=("s3tests/functional/test_s3.py" "-v" "--tb=short" "--timeout=30"
        "--junitxml=/s3-tests/output/results_phase2.xml" "-k" "$OBJECT_LOCK_FILTER")
    $COMPOSE run --rm s3-tests "${PHASE2_ARGS[@]}" || EXIT_CODE=$?

    # Merge results: concatenate XML files for the report generator
    echo "==> Merging test results..."
    python3 -c "
import xml.etree.ElementTree as ET, sys, os
merged = ET.Element('testsuites')
for f in ['s3-tests/results_phase1.xml', 's3-tests/results_phase2.xml']:
    if os.path.exists(f):
        tree = ET.parse(f)
        for suite in tree.getroot().iter('testsuite'):
            merged.append(suite)
        # Also handle case where root IS a testsuite
        root = tree.getroot()
        if root.tag == 'testsuite':
            merged.append(root)
ET.ElementTree(merged).write('s3-tests/results.xml', xml_declaration=True, encoding='unicode')
" 2>/dev/null || {
        # Fallback: just use phase1 results if merge fails
        cp s3-tests/results_phase1.xml s3-tests/results.xml 2>/dev/null || true
    }
else
    echo "==> Running s3-tests..."
    EXIT_CODE=0
    $COMPOSE run --rm s3-tests "${PYTEST_ARGS[@]}" || EXIT_CODE=$?
fi

# Generate HTML report if results.xml exists
if [[ -f "s3-tests/results.xml" ]]; then
    echo ""
    echo "==> Generating compatibility report..."
    $COMPOSE run --rm --entrypoint python s3-tests /s3-tests/report.py \
        /s3-tests/output/results.xml /s3-tests/output/report.html \
        /s3-tests/output/passlist.txt 2>/dev/null || true

    # Publish report and badge to GitHub Pages documentation
    if [[ -f "s3-tests/report.html" ]]; then
        GH_PAGES_DIR="documentation/docs/s3-compatibility"
        DOCS_OUT_DIR="docs/s3-compatibility"
        mkdir -p "$GH_PAGES_DIR" "$DOCS_OUT_DIR"
        cp s3-tests/report.html "$GH_PAGES_DIR/index.html"
        cp s3-tests/report.html "$DOCS_OUT_DIR/index.html"
        echo "==> Report published to $GH_PAGES_DIR/index.html"
    fi
    if [[ -f "s3-tests/s3-compatibility-badge.svg" ]]; then
        cp s3-tests/s3-compatibility-badge.svg s3-compatibility-badge.svg
        echo "==> Badge updated: s3-compatibility-badge.svg"
    fi
    if [[ -f "s3-tests/summary.json" ]]; then
        echo "==> Summary: s3-tests/summary.json"
        cat s3-tests/summary.json
    fi
fi

# Stop the test Arca instance (user can restart with their preferred config)
if ! $NO_CLEAN; then
    echo ""
    echo "==> Stopping s3-test Arca instance..."
    bin/arca stop 2>/dev/null || true
    echo "==> Done. Restart Arca with your preferred config (e.g. bin/arca start -d --dev --encryption)."
fi

exit $EXIT_CODE
