#!/usr/bin/env bash
set -euo pipefail

# Manage the Arca server container.
#
# Usage:
#   bin/arca start                Start in foreground
#   bin/arca start -d             Start in background
#   bin/arca start -d --build     Start in background, rebuild image first
#   bin/arca start -d --dev       Start development image (has shell)
#   bin/arca start -d --tls       Start with TLS (requires certs in ./certs/)
#   bin/arca start -d -c <path>   Start with a custom config file
#   bin/arca stop                 Stop the server
#   bin/arca status               Show container status
#   bin/arca logs                 Show logs
#   bin/arca logs -f              Follow logs

cd "$(git rev-parse --show-toplevel)"

COMPOSE="docker compose -f docker/docker-compose.yml"

usage() {
    echo "Usage: bin/arca <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start [-d] [--build] [--dev] [--tls] [--config <path>]"
    echo "                                          Start the Arca server"
    echo "  stop                                    Stop the Arca server"
    echo "  status                                  Show container status"
    echo "  logs [-f]                               Show server logs"
    echo ""
    echo "Options:"
    echo "  -d              Run in background (detached)"
    echo "  --build         Rebuild the Docker image before starting"
    echo "  --dev           Use development image (debian-slim, has shell)"
    echo "  --tls           Enable HTTPS (certificates must be in ./certs/)"
    echo "  --config <path> Use a custom config file (mounted into the container)"
    echo "  -f              Follow log output"
    exit 0
}

cleanup_config_override() {
    [[ -n "${CONFIG_OVERRIDE:-}" ]] && rm -f "$CONFIG_OVERRIDE"
}

cmd_start() {
    local detach=false
    local build=false
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d)       detach=true; shift ;;
            --build)  build=true; shift ;;
            --dev)    export BUILD_TARGET=development; shift ;;
            --tls)    COMPOSE="$COMPOSE -f docker/docker-compose.tls.yml"; shift ;;
            -c|--config)
                if [[ -z "${2:-}" ]]; then
                    echo "Error: --config requires a file path" >&2
                    exit 1
                fi
                if [[ ! -f "$2" ]]; then
                    echo "Error: config file not found: $2" >&2
                    exit 1
                fi
                CONFIG_OVERRIDE=$(mktemp /tmp/arca-config-XXXXXX.yml)
                trap cleanup_config_override EXIT
                local abs_path
                abs_path=$(cd "$(dirname "$2")" && echo "$(pwd)/$(basename "$2")")
                cat > "$CONFIG_OVERRIDE" <<YAML
services:
  arca:
    volumes:
      - ${abs_path}:/etc/arca/config.toml:ro
YAML
                COMPOSE="$COMPOSE -f $CONFIG_OVERRIDE"
                shift 2
                ;;
            *)        echo "Unknown option: $1" >&2; usage ;;
        esac
    done

    if $build; then
        echo "Building ${BUILD_TARGET:-production} image..."
        $COMPOSE build arca
    fi

    if $detach; then
        args+=("-d")
    fi

    $COMPOSE up "${args[@]+"${args[@]}"}" arca
}

cmd_stop() {
    $COMPOSE down "$@"
}

cmd_status() {
    $COMPOSE ps arca
}

cmd_logs() {
    local follow=false
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f)  follow=true; shift ;;
            *)   echo "Unknown option: $1" >&2; usage ;;
        esac
    done

    if $follow; then
        args+=("-f")
    fi

    $COMPOSE logs "${args[@]+"${args[@]}"}" arca
}

[[ $# -lt 1 ]] && usage

command="$1"
shift

case "$command" in
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    status)  cmd_status "$@" ;;
    logs)    cmd_logs "$@" ;;
    -h|--help) usage ;;
    *)       echo "Unknown command: $command" >&2; usage ;;
esac
