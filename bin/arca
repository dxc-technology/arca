#!/usr/bin/env bash
set -euo pipefail

# Manage the Arca server container.
#
# Usage:
#   bin/arca start                    Start in foreground
#   bin/arca start -d                 Start in background
#   bin/arca start -d --build         Start in background, rebuild image first
#   bin/arca start -d --dev           Start development image (has shell)
#   bin/arca start -d --tls           Start with TLS (requires certs in ./certs/)
#   bin/arca start -d --encryption    Start with global encryption (local key)
#   bin/arca start -d --encryption --per-bucket  Encryption available per-bucket only
#   bin/arca start -d --kms           Start with global encryption (KMS)
#   bin/arca start -d --kms --per-bucket  KMS encryption available per-bucket only
#   bin/arca start -d --postgres      Start with PostgreSQL metadata backend
#   bin/arca start -d --config <path> Start with a custom config file
#   bin/arca stop                     Stop the server (and all associated services)
#   bin/arca status                   Show container status
#   bin/arca logs                     Show logs
#   bin/arca logs -f                  Follow logs

cd "$(git rev-parse --show-toplevel)"
source bin/lib/compose.sh

usage() {
    echo "Usage: bin/arca <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start   Start the Arca server"
    echo "  stop    Stop the Arca server (and all associated services)"
    echo "  status  Show container status"
    echo "  logs    Show server logs"
    echo ""
    echo "Run 'bin/arca <command> --help' for command-specific options."
    exit "${1:-0}"
}

usage_start() {
    echo "Usage: bin/arca start [-d] [--build] [--dev] [--tls] [--encryption|--kms] [--per-bucket] [--postgres] [--replication|--cluster] [--config <path>]"
    echo ""
    echo "Options:"
    echo "  -d              Run in background (detached)"
    echo "  --build         Rebuild the Docker image before starting"
    echo "  --dev           Use development image (debian-slim, has shell)"
    echo "  --tls           Enable HTTPS (certificates must be in ./certs/)"
    echo "  --encryption    Enable server-side encryption with local key"
    echo "  --kms           Enable server-side encryption with OpenBAO KMS"
    echo "  --per-bucket    Disable global encryption, enable per-bucket only"
    echo "                  (requires --encryption or --kms)"
    echo "  --replication   Start a second Arca instance (arca-replica on :9001)"
    echo "  --cluster       Enable HA clustering (single-node dev cluster; mutually exclusive with --replication)"
    echo "  --postgres      Use PostgreSQL as metadata backend"
    echo "  --config <path> Use a custom config file (overrides fragments)"
    exit "${1:-0}"
}

usage_logs() {
    echo "Usage: bin/arca logs [-f]"
    echo ""
    echo "Options:"
    echo "  -f  Follow log output"
    exit "${1:-0}"
}

cmd_start() {
    local detach=false
    local build=false
    local custom_config=""
    local want_tls=false
    local want_encryption=false
    local want_kms=false
    local want_per_bucket=false
    local want_postgres=false
    local want_replication=false
    local want_cluster=false

    # Parse all flags first (order-independent)
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d)           detach=true; shift ;;
            --build)      build=true; shift ;;
            --dev)        export BUILD_TARGET=development; shift ;;
            --tls)        want_tls=true; shift ;;
            --encryption) want_encryption=true; shift ;;
            --kms)        want_kms=true; shift ;;
            --per-bucket) want_per_bucket=true; shift ;;
            --postgres)   want_postgres=true; shift ;;
            --replication) want_replication=true; shift ;;
            --cluster)    want_cluster=true; shift ;;
            --config|-c)
                if [[ -z "${2:-}" ]]; then
                    echo "Error: --config requires a file path" >&2
                    exit 1
                fi
                if [[ ! -f "$2" ]]; then
                    echo "Error: config file not found: $2" >&2
                    exit 1
                fi
                custom_config="$2"
                shift 2
                ;;
            -h|--help) usage_start 0 ;;
            *)  echo "Error: unknown option '$1' for 'start'" >&2; usage_start 1 ;;
        esac
    done

    # Validate and resolve features
    if $want_encryption && $want_kms; then
        echo "Error: --encryption and --kms are mutually exclusive" >&2
        exit 1
    fi
    if $want_per_bucket && ! $want_encryption && ! $want_kms; then
        echo "Error: --per-bucket requires --encryption or --kms" >&2
        exit 1
    fi
    if $want_cluster && $want_replication; then
        echo "Error: --cluster and --replication are mutually exclusive" >&2
        exit 1
    fi

    if $want_tls; then enable_tls; fi
    if $want_encryption; then
        if $want_per_bucket; then enable_encryption_per_bucket
        else enable_encryption; fi
    fi
    if $want_kms; then
        if $want_per_bucket; then enable_kms_per_bucket
        else enable_kms; fi
    fi
    if $want_postgres; then enable_postgres; fi
    if $want_replication; then enable_replication; fi
    if $want_cluster; then enable_cluster; fi

    # Handle custom config: copy to .generated.toml, skip fragment concatenation
    if [[ -n "$custom_config" ]]; then
        cp "$custom_config" "$GENERATED_CONFIG"
        _FEATURES+=(custom)
    else
        build_config
    fi

    save_env

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    if $build; then
        local build_args=()
        if [[ "${BUILD_TARGET:-}" == "development" ]]; then
            build_args+=(--dev)
        fi
        bin/build "${build_args[@]}"
    fi

    if $_HAS_POSTGRES; then
        echo "Starting PostgreSQL..."
        $COMPOSE up -d postgres
        wait_for_postgres "$COMPOSE"
    fi

    if $_HAS_KMS; then
        echo "Starting OpenBAO KMS..."
        $COMPOSE up -d openbao
        wait_for_openbao "$COMPOSE"
        echo "Initializing KV v2 secrets..."
        $COMPOSE --profile kms-init run --rm openbao-init
    fi

    local args=()
    if $detach; then
        args+=("-d")
    else
        # When running in foreground, ensure all services (e.g. OpenBAO)
        # are stopped when the user presses CTRL+C
        trap "$COMPOSE --profile console down; clean_env" EXIT
    fi

    $COMPOSE up "${args[@]+"${args[@]}"}" arca
}

cmd_stop() {
    load_env
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    # Include console profile so its container is removed along with the
    # network.  Without this, switching features (e.g. --encryption to --kms)
    # leaves a stale console container attached to the deleted network.
    $COMPOSE --profile console down
    clean_env
}

cmd_status() {
    load_env
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE ps arca
}

cmd_logs() {
    local follow=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f)  follow=true; shift ;;
            -h|--help) usage_logs 0 ;;
            *)   echo "Error: unknown option '$1' for 'logs'" >&2; usage_logs 1 ;;
        esac
    done

    load_env
    local COMPOSE
    COMPOSE="$(compose_cmd)"

    local args=()
    if $follow; then
        args+=("-f")
    fi

    $COMPOSE logs "${args[@]+"${args[@]}"}" arca | localize_log_timestamps
}

[[ $# -lt 1 ]] && usage 0

command="$1"
shift

case "$command" in
    start)     cmd_start "$@" ;;
    stop)      cmd_stop ;;
    status)    cmd_status ;;
    logs)      cmd_logs "$@" ;;
    -h|--help) usage 0 ;;
    *)         echo "Error: unknown command '$command'" >&2; usage 1 ;;
esac
