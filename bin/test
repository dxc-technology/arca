    trap - EXIT
    cleanup_connector_mysql
    return $rc
}

run_connector_mongodb() {
    echo "==> Running MongoDB connector integration tests..."

    enable_connector_mongodb
    build_config

    _CONNECTOR_COMPOSE="$(compose_cmd)"

    cleanup_connector_mongodb() {
        echo "Cleaning up MongoDB connector test..."
        $_CONNECTOR_COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_connector_mongodb EXIT

    $_CONNECTOR_COMPOSE build arca
    $_CONNECTOR_COMPOSE up -d mongodb-receiver
    wait_for_mongodb_receiver "$_CONNECTOR_COMPOSE"
    $_CONNECTOR_COMPOSE up -d arca
    wait_for_arca "$_CONNECTOR_COMPOSE"
    $_CONNECTOR_COMPOSE run --rm \
        -e MONGODB_URL=mongodb://mongodb-receiver:27017 \
        test connectors/test_mongodb.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_connector_mongodb
    return $rc
}

