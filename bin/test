#!/usr/bin/env bash
set -euo pipefail

# Run tests inside Docker.
#
# Usage:
#   bin/test              Run unit tests + integration tests
#   bin/test unit         Run unit tests only
#   bin/test integration  Run integration tests only (server must be running)
#   bin/test unit -p arca-core   Pass extra args to cargo test
#   bin/test tls          Run TLS integration tests
#   bin/test encryption   Run encryption integration tests
#   bin/test per-bucket-encryption  Run per-bucket encryption tests
#   bin/test kms          Run KMS integration tests
#   bin/test postgres     Run PostgreSQL backend integration tests
#   bin/test s3-compat    Run Ceph s3-tests compatibility suite
#   bin/test connectors redis        Run Redis connector integration tests
#   bin/test connectors nats         Run NATS connector integration tests
#   bin/test connectors mqtt         Run MQTT connector integration tests
#   bin/test connectors postgresql   Run PostgreSQL connector integration tests
#   bin/test connectors mysql        Run MySQL connector integration tests
#   bin/test connectors mongodb      Run MongoDB connector integration tests
#   bin/test connectors smtp         Run SMTP connector integration tests
#   bin/test connectors grpc         Run gRPC connector integration tests
#   bin/test connectors all          Run all connector integration tests

cd "$(git rev-parse --show-toplevel)"
source bin/lib/compose.sh

run_unit() {
    echo "==> Running unit tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm unit-test "$@"
}

run_integration() {
    echo "==> Running integration tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm test "$@"
}

run_tls() {
    echo "==> Running TLS integration tests..."

    # tls-explicit includes explicit cert filenames AND triggers the TLS compose overlay
    enable_tls_explicit
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"
    local generated_certs=()

    cleanup_tls() {
        echo "Cleaning up TLS test..."
        $COMPOSE --profile tls-test down -v 2>/dev/null || true
        for f in "${generated_certs[@]}"; do
            rm -f "$f"
        done
    }
    trap cleanup_tls EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Generate self-signed certs into ./certs/
    mkdir -p certs
    $COMPOSE --profile tls-init run --rm tls-init
    generated_certs=(certs/arca-ca.crt certs/arca-ca.key certs/arca-server.crt certs/arca-server.key)
    # Step 3: Start server with TLS config
    $COMPOSE up -d arca
    # Step 4: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 5: Run TLS-specific tests
    $COMPOSE --profile tls-test run --rm \
        -e ARCA_ENDPOINT=https://arca:9000 \
        -e AWS_CA_BUNDLE=/etc/arca/certs/arca-ca.crt \
        test integration/test_tls.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_tls
    return $rc
}

run_encryption() {
    echo "==> Running encryption integration tests..."

    enable_encryption
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_enc() {
        echo "Cleaning up encryption test..."
