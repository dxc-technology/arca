}

run_replication() {
    echo "==> Running replication integration tests..."

    enable_replication
    build_config

    # Use a global so the EXIT trap can still see the compose command
    # after run_replication returns.
    _REPL_COMPOSE="$(compose_cmd)"

    cleanup_repl() {
        echo "Cleaning up replication test..."
        ${_REPL_COMPOSE:-docker compose} down -v 2>/dev/null || true
    }
    trap cleanup_repl EXIT

    # Step 1: Build images (source Arca + replica reuse the same image)
    $_REPL_COMPOSE build arca
    # Step 2: Start both instances.
    $_REPL_COMPOSE up -d arca arca-replica
    wait_for_arca "$_REPL_COMPOSE"
    # Wait for the replica separately (shares the same image, different service name).
    echo "Waiting for arca-replica..."
    for i in $(seq 1 30); do
        if $_REPL_COMPOSE exec -T arca-replica /usr/local/bin/arca --help >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    sleep 2
    # Step 3: Run replication tests. `|| true` so a pytest failure doesn't
    # abort the function under set -e — we capture the code and return it.
    local rc=0
    $_REPL_COMPOSE run --rm test integration/test_replication.py "$@" || rc=$?

    trap - EXIT
    cleanup_repl
    return $rc
}

# --- 3-node HA cluster tests ---

# Live node count as seen by the node on host port $1 (via public health).
_node_live() {
    curl -fsS "http://localhost:${1}/admin/health?verbose=1" 2>/dev/null \
        | jq -r '.cluster.live_node_count // empty' 2>/dev/null
}

# Node number (1-3) of the current worker leader (R6, decision H5), found by
# asking each node whether it claims the role via verbose health.
_leader_node() {
    local n
    for n in 1 2 3; do
        if [[ "$(curl -fsS "http://localhost:$((9000 + n))/admin/health?verbose=1" 2>/dev/null \
            | jq -r '.cluster.worker_leader // empty' 2>/dev/null)" == "true" ]]; then
            echo "$n"
            return 0
        fi
    done
    return 1
}

# Wait until the node on host port $1 reports exactly $2 live nodes.
wait_live() {
    local port="$1" want="$2" max="${3:-90}"
    echo "Waiting for the cluster to report $want live node(s) on :$port..."
    for _ in $(seq 1 "$max"); do
        # Membership convergence on one node does not mean HAProxy has caught
        # up: with `fall 2 inter 2s` it takes up to ~4s to evict a dead node
        # from rotation, so give the LB a 5s margin before tests hit it.
        [[ "$(_node_live "$port")" == "$want" ]] && { sleep 5; return 0; }
        sleep 1
    done
    echo "Timed out waiting for live==$want on :$port" >&2
    return 1
}

run_cluster() {
    echo "==> Running 3-node HA cluster integration tests..."

    local PROJECT="arca-cluster"
    local BASE="docker/docker-compose.cluster.yml"
    local C="docker compose -p $PROJECT -f $BASE"

    cleanup_cluster() {
        echo "Cleaning up cluster test..."
        docker compose -p arca-cluster -f docker/docker-compose.cluster.yml down -v 2>/dev/null || true
    }
    trap cleanup_cluster EXIT

    # On a phase failure, preserve the node logs BEFORE `down -v` destroys
    # them — needed to diagnose the rare anti-entropy flakes (M1 class, see
    # the hardening plan): by the time a human looks, the volumes are gone.
    dump_logs_on_failure() {
        local rc="$1"; shift
        if [[ "$rc" -ne 0 ]]; then
            local out="/tmp/arca-cluster-failure-$(date +%Y%m%d-%H%M%S).log"
            "$@" logs --no-color --timestamps > "$out" 2>&1 || true
            echo "Cluster phase failed — node logs preserved at $out" >&2
        fi
    }

    # Start from a clean slate (tear down any cluster left running).
    $C down -v 2>/dev/null || true

    local rc=0
    local T="integration/test_cluster.py"

    # All three nodes share the one `arca` image tag, so building a single node
    # produces it; the others reuse the tag at `up` time. Also build the runner.
    $C build arca-1 test || rc=$?

    # ── Phases A–D share one cluster lifecycle; nodes are stopped/started
    #    between phases (a kill/restart can't be driven from a test container).
    if [[ $rc -eq 0 ]]; then
        echo "── Phase A: all 3 nodes up ──"
        $C up -d
        wait_live 9001 3 90 || rc=1
        [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_full -v "$@" || rc=$?; }
    fi

    if [[ $rc -eq 0 ]]; then
        echo "── Phase B: node 3 down (2 of 3 — quorum still met) ──"
        $C stop arca-3
        wait_live 9001 2 60 || rc=1
        [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_two_thirds -v "$@" || rc=$?; }
    fi

    if [[ $rc -eq 0 ]]; then
        echo "── Phase C: nodes 2 & 3 down (1 of 3 — no quorum) ──"
        $C stop arca-2
        wait_live 9001 1 60 || rc=1
        [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_one_third -v "$@" || rc=$?; }
    fi

    if [[ $rc -eq 0 ]]; then
        echo "── Phase D: all nodes back up (anti-entropy convergence) ──"
        $C start arca-2 arca-3
        wait_live 9001 3 90 || rc=1
        [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_catchup_verify -v "$@" || rc=$?; }
    fi

    # Fresh volumes for the special-topology phases.
    dump_logs_on_failure $rc $C
    $C down -v 2>/dev/null || true

    if [[ $rc -eq 0 ]]; then
        echo "── Phase E: 507 InsufficientStorage (tiny-disk node) ──"
        local C507="$C -f docker/docker-compose.cluster.507.yml"
        $C507 up -d
        wait_live 9001 3 90 || rc=1
        [[ $rc -eq 0 ]] && { $C507 run --rm --no-deps test "$T" -m cluster_insufficient_storage -v "$@" || rc=$?; }
        dump_logs_on_failure $rc $C507
        $C507 down -v 2>/dev/null || true
    fi

    if [[ $rc -eq 0 ]]; then
        echo "── Phase F: config-drift detection (mismatched secret) ──"
        # The liveness probe answers everyone, so all 3 nodes stay "live" —
        # but the drifted node fails the authenticated ping (403) and is
        # flagged AND excluded from the quorum (R3, decisions H7/H12).
        local CDRIFT="$C -f docker/docker-compose.cluster.drift.yml"
        $CDRIFT up -d
        wait_live 9001 3 90 || rc=1
        [[ $rc -eq 0 ]] && { $CDRIFT run --rm --no-deps test "$T" -m cluster_config_drift -v "$@" || rc=$?; }

        # Second half: de-align arca-2 too (its own distinct wrong secret).
        # Only arca-2 is recreated — volumes persist, so the object seeded in
        # the first half is still on arca-1 for the read assertion. With 2 of
        # 3 nodes drifted the aligned node must refuse writes with 503.
        if [[ $rc -eq 0 ]]; then
            echo "── Phase F2: drifted majority (2 of 3 nodes mismatched) ──"
            local CDRIFT2="$CDRIFT -f docker/docker-compose.cluster.drift2.yml"
            $CDRIFT2 up -d
            wait_live 9001 3 90 || rc=1
            [[ $rc -eq 0 ]] && { $CDRIFT2 run --rm --no-deps test "$T" -m cluster_config_drift_majority -v "$@" || rc=$?; }
            dump_logs_on_failure $rc $CDRIFT2
            $CDRIFT2 down -v 2>/dev/null || true
        else
            dump_logs_on_failure $rc $CDRIFT
            $CDRIFT down -v 2>/dev/null || true
        fi
    fi

    # ── Phases G–H exercise a REAL network partition: bin/cluster partition/heal
    #    (same compose project) cut a node off the `cluster` network while its
    #    process stays alive; the `mgmt` network keeps the test runner connected
    #    to it. Self-contained phases (fresh up / down -v): after a heal the node
    #    may re-attach with a new IP that HAProxy (startup-resolved) won't track.
    #    wait_live polls node 1 only — a partitioned node's host port goes dark.

    if [[ $rc -eq 0 ]]; then
        echo "── Phase G: quorum mode under a network partition ──"
        $C up -d
        wait_live 9001 3 90 || rc=1
        [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_partition_before -v "$@" || rc=$?; }
        if [[ $rc -eq 0 ]]; then
            bin/cluster partition 3 || rc=$?
            # No wait_live here, on purpose: the 503 on the isolated node must
            # hold even before membership notices the partition (the missing
            # fan-out ACKs close that window — review §2.1).
            [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_partition_minority -v "$@" || rc=$?; }
            bin/cluster heal 3 || rc=$?
        fi
        if [[ $rc -eq 0 ]]; then
            wait_live 9001 3 90 || rc=1
            [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_partition_healed -v "$@" || rc=$?; }
        fi
        dump_logs_on_failure $rc $C
        $C down -v 2>/dev/null || true
    fi

    if [[ $rc -eq 0 ]]; then
        echo "── Phase H: available mode (split-brain LWW + minority writes) ──"
        local CAVAIL="$C -f docker/docker-compose.cluster.available.yml"
        $CAVAIL up -d
        wait_live 9001 3 90 || rc=1
        [[ $rc -eq 0 ]] && { $CAVAIL run --rm --no-deps test "$T" -m cluster_available_full -v "$@" || rc=$?; }
        if [[ $rc -eq 0 ]]; then
            bin/cluster partition 3 || rc=$?
            [[ $rc -eq 0 ]] && { $CAVAIL run --rm --no-deps test "$T" -m cluster_available_split -v "$@" || rc=$?; }
            bin/cluster heal 3 || rc=$?
        fi
        if [[ $rc -eq 0 ]]; then
            wait_live 9001 3 90 || rc=1
            [[ $rc -eq 0 ]] && { $CAVAIL run --rm --no-deps test "$T" -m cluster_available_converged -v "$@" || rc=$?; }
        fi
        if [[ $rc -eq 0 ]]; then
            $CAVAIL stop arca-2 arca-3
            wait_live 9001 1 60 || rc=1
            [[ $rc -eq 0 ]] && { $CAVAIL run --rm --no-deps test "$T" -m cluster_available_minority -v "$@" || rc=$?; }
        fi
        dump_logs_on_failure $rc $CAVAIL
        $CAVAIL down -v 2>/dev/null || true
    fi

    if [[ $rc -eq 0 ]]; then
        echo "── Phase I: worker-leader gate (lifecycle exactly-once + failover) ──"
        # The leader is the node with the lowest node_id — random UUIDs, so
        # WHICH container holds the role differs per run: it is discovered via
        # verbose health, then stopped to verify the failover.
        $C up -d
        wait_live 9001 3 90 || rc=1
        [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_leader_full -v "$@" || rc=$?; }
        if [[ $rc -eq 0 ]]; then
            local leader survivor
            leader="$(_leader_node)" || rc=1
            if [[ $rc -eq 0 ]]; then
                echo "Stopping the worker leader (arca-$leader)..."
                $C stop "arca-$leader"
                survivor=$(( leader == 1 ? 9002 : 9001 ))
                wait_live "$survivor" 2 60 || rc=1
                [[ $rc -eq 0 ]] && { $C run --rm --no-deps test "$T" -m cluster_leader_failover -v "$@" || rc=$?; }
            fi
        fi
        dump_logs_on_failure $rc $C
        $C down -v 2>/dev/null || true
    fi

    trap - EXIT
    cleanup_cluster
    return $rc
}

run_notifications() {
    echo "==> Running notification integration tests..."

    enable_notifications
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_notif() {
        echo "Cleaning up notification test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_notif EXIT

    # Step 1: Build images
    $COMPOSE build arca webhook-receiver
    # Step 2: Start webhook receiver and Arca
    $COMPOSE up -d webhook-receiver
    $COMPOSE up -d arca
    # Step 3: Wait for services to be ready
    wait_for_arca "$COMPOSE"
    echo "Waiting for webhook receiver..."
    for i in $(seq 1 30); do
        if $COMPOSE exec -T webhook-receiver wget -q --spider http://localhost:8765/health 2>/dev/null; then
            echo "Webhook receiver ready"
            break
        fi
        sleep 1
    done
    # Step 4: Run notification tests
    $COMPOSE run --rm \
        -e WEBHOOK_RECEIVER_URL=http://webhook-receiver:8765 \
        test integration/test_notifications.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_notif
    return $rc
}

