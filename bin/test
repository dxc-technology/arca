run_connectors() {
    local connector="${1:-}"
    if [[ -z "$connector" ]]; then
        echo "Error: specify a connector name or 'all'" >&2
        echo "Usage: bin/test connectors <redis|nats|mqtt|postgresql|mysql|mongodb|kafka|amqp|elasticsearch|syslog|smtp|grpc|all>" >&2
        exit 1
    fi
    shift

    case "$connector" in
        redis)
            run_connector_redis "$@"
            ;;
        nats)
            run_connector_nats "$@"
            ;;
        mqtt)
            run_connector_mqtt "$@"
            ;;
        postgresql)
            run_connector_postgresql "$@"
            ;;
        mysql)
            run_connector_mysql "$@"
            ;;
        mongodb)
            run_connector_mongodb "$@"
            ;;
        kafka)
            run_connector_kafka "$@"
            ;;
        amqp)
            run_connector_amqp "$@"
            ;;
        elasticsearch)
            run_connector_elasticsearch "$@"
            ;;
        syslog)
            run_connector_syslog "$@"
            ;;
        smtp)
            run_connector_smtp "$@"
            ;;
        grpc)
            run_connector_grpc "$@"
            ;;
        all)
            run_connector_redis "$@"
            run_connector_nats "$@"
            run_connector_mqtt "$@"
            run_connector_postgresql "$@"
            run_connector_mysql "$@"
            run_connector_mongodb "$@"
            run_connector_kafka "$@"
            run_connector_amqp "$@"
            run_connector_elasticsearch "$@"
            run_connector_syslog "$@"
            run_connector_smtp "$@"
            run_connector_grpc "$@"
            ;;
        *)
            echo "Error: unknown connector '$connector'" >&2
            echo "Available connectors: redis, nats, mqtt, postgresql, mysql, mongodb, kafka, amqp, elasticsearch, syslog, smtp, grpc, all" >&2
            exit 1
            ;;
    esac
}

run_s3_compat() {
    echo "==> Running s3-tests compatibility suite..."
    exec "$(git rev-parse --show-toplevel)/bin/s3-tests" "$@"
}

case "${1:-all}" in
    unit)
        shift
        run_unit "$@"
        ;;
    integration)
        shift
        run_integration "$@"
        ;;
    tls)
        shift
        run_tls "$@"
        ;;
    encryption)
        shift
        run_encryption "$@"
        ;;
    per-bucket-encryption)
        shift
        run_per_bucket_encryption "$@"
        ;;
    kms)
        shift
        run_kms "$@"
        ;;
    postgres)
        shift
        run_postgres "$@"
        ;;
    presigned)
        shift
        run_presigned "$@"
        ;;
    ssec)
        shift
        run_ssec "$@"
        ;;
    notifications)
        shift
        run_notifications "$@"
        ;;
    connectors)
        shift
        run_connectors "$@"
        ;;
    s3-compat)
        shift
        run_s3_compat "$@"
        ;;
    all)
        run_unit
        echo ""
        run_integration
        ;;
    -h|--help)
        echo "Usage: bin/test <mode> [extra args...]"
        echo ""
        echo "Modes:"
        echo "  all                  Run unit + integration tests (default)"
        echo "  unit                 Run unit tests only"
        echo "  integration          Run integration tests only (server must be running)"
        echo "  tls                  Run TLS integration tests (self-contained)"
        echo "  encryption           Run encryption integration tests"
        echo "  per-bucket-encryption  Run per-bucket encryption tests"
        echo "  kms                  Run KMS integration tests (with OpenBAO)"
        echo "  postgres             Run PostgreSQL backend integration tests"
        echo "  presigned            Run presigned URL integration tests"
        echo "  ssec                 Run SSE-C integration tests"
        echo "  connectors <type>    Run connector integration tests (redis, nats, mqtt, postgresql, mysql, mongodb, kafka, amqp, elasticsearch, syslog, smtp, grpc, all)"
        echo "  s3-compat            Run Ceph s3-tests compatibility suite"
        echo ""
        echo "Extra args are passed to the test runner (cargo test or pytest)."
        echo "Example: bin/test unit -p arca-core"
        exit 0
        ;;
    *)
        echo "Error: unknown test mode '$1'" >&2
        echo "Run 'bin/test --help' for available modes." >&2
        exit 1
        ;;
esac
