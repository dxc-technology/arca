        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_pbe EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start server with per-bucket encryption config (key present, enabled=false)
    $COMPOSE up -d arca
    # Step 3: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 4: Run per-bucket encryption tests
    $COMPOSE run --rm \
        -e ARCA_PER_BUCKET_ENCRYPTION=1 \
        test integration/test_per_bucket_encryption.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_pbe
    return $rc
}

run_kms() {
    echo "==> Running KMS integration tests..."

    enable_kms
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_kms() {
        echo "Cleaning up KMS test..."
        $COMPOSE --profile kms-init down -v 2>/dev/null || true
    }
    trap cleanup_kms EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start OpenBAO and wait for healthy
    $COMPOSE up -d openbao
    wait_for_openbao "$COMPOSE"
    # Step 3: Initialize KV v2 secrets (write master key, AppRole, etc.)
    $COMPOSE --profile kms-init run --rm openbao-init
    # Step 4: Start Arca with KMS config
    $COMPOSE up -d arca
    # Step 5: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 6: Run KMS-specific tests
    $COMPOSE run --rm \
        -e ARCA_KMS_ENABLED=1 \
        test integration/test_kms.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_kms
    return $rc
}

run_postgres() {
    echo "==> Running PostgreSQL backend integration tests..."

    enable_postgres
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_pg() {
        echo "Cleaning up PostgreSQL test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_pg EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start PostgreSQL and wait for healthy
    $COMPOSE up -d postgres
    wait_for_postgres "$COMPOSE"
    # Step 3: Start Arca with PostgreSQL config (migrations run at startup)
    $COMPOSE up -d arca
    # Step 4: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 5: Run PostgreSQL-specific tests
    $COMPOSE run --rm \
        -e ARCA_POSTGRES_BACKEND=1 \
        test integration/test_postgres.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_pg
    return $rc
}

run_presigned() {
    echo "==> Running presigned URL integration tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm test integration/test_presigned.py "$@"
}

run_ssec() {
    echo "==> Running SSE-C integration tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm test integration/test_ssec.py "$@"
}

run_notifications() {
    echo "==> Running notification integration tests..."

    enable_notifications
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_notif() {
        echo "Cleaning up notification test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_notif EXIT

    # Step 1: Build images
    $COMPOSE build arca webhook-receiver
    # Step 2: Start webhook receiver and Arca
    $COMPOSE up -d webhook-receiver
    $COMPOSE up -d arca
    # Step 3: Wait for services to be ready
    wait_for_arca "$COMPOSE"
    echo "Waiting for webhook receiver..."
    for i in $(seq 1 30); do
        if $COMPOSE exec -T webhook-receiver wget -q --spider http://localhost:8765/health 2>/dev/null; then
            echo "Webhook receiver ready"
            break
        fi
        sleep 1
    done
    # Step 4: Run notification tests
    $COMPOSE run --rm \
        -e WEBHOOK_RECEIVER_URL=http://webhook-receiver:8765 \
        test integration/test_notifications.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_notif
    return $rc
}

# --- Connector tests (dedicated stream, not part of bin/test all) ---

run_connector_redis() {
    echo "==> Running Redis connector integration tests..."

    enable_connector_redis
    build_config

    _CONNECTOR_COMPOSE="$(compose_cmd)"

    cleanup_connector_redis() {
        echo "Cleaning up Redis connector test..."
        $_CONNECTOR_COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_connector_redis EXIT

    # Step 1: Build images
    $_CONNECTOR_COMPOSE build arca
    # Step 2: Start Redis receiver and wait for healthy
    $_CONNECTOR_COMPOSE up -d redis-receiver
    wait_for_redis "$_CONNECTOR_COMPOSE"
    # Step 3: Start Arca with notifications config
    $_CONNECTOR_COMPOSE up -d arca
    wait_for_arca "$_CONNECTOR_COMPOSE"
    # Step 4: Run Redis connector tests
    $_CONNECTOR_COMPOSE run --rm \
        -e REDIS_URL=redis://redis-receiver:6379 \
        test connectors/test_redis.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_connector_redis
    return $rc
}

