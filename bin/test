    trap cleanup_kms EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start OpenBAO and wait for healthy
    $COMPOSE up -d openbao
    wait_for_openbao "$COMPOSE"
    # Step 3: Initialize KV v2 secrets (write master key, AppRole, etc.)
    $COMPOSE --profile kms-init run --rm openbao-init
    # Step 4: Start Arca with KMS config
    $COMPOSE up -d arca
    # Step 5: Wait for server to be ready
    wait_for_arca "$COMPOSE"
