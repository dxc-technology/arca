#!/usr/bin/env bash
set -euo pipefail

# Run tests inside Docker.
#
# Usage:
#   bin/test              Run unit tests + integration tests
#   bin/test unit         Run unit tests only
#   bin/test integration  Run integration tests only (server must be running)
#   bin/test unit -p arca-core   Pass extra args to cargo test
#   bin/test tls          Run TLS integration tests
#   bin/test encryption   Run encryption integration tests
#   bin/test per-bucket-encryption  Run per-bucket encryption tests
#   bin/test kms          Run KMS integration tests
#   bin/test postgres     Run PostgreSQL backend integration tests
#   bin/test s3-compat    Run Ceph s3-tests compatibility suite

cd "$(git rev-parse --show-toplevel)"
source bin/lib/compose.sh

run_unit() {
    echo "==> Running unit tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm unit-test "$@"
}

run_integration() {
    echo "==> Running integration tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm test "$@"
}

run_tls() {
    echo "==> Running TLS integration tests..."

    # tls-explicit includes explicit cert filenames AND triggers the TLS compose overlay
    enable_tls_explicit
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"
    local generated_certs=()

    cleanup_tls() {
        echo "Cleaning up TLS test..."
        $COMPOSE --profile tls-test down -v 2>/dev/null || true
        for f in "${generated_certs[@]}"; do
            rm -f "$f"
        done
    }
    trap cleanup_tls EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Generate self-signed certs into ./certs/
    mkdir -p certs
    $COMPOSE --profile tls-init run --rm tls-init
    generated_certs=(certs/arca-ca.crt certs/arca-ca.key certs/arca-server.crt certs/arca-server.key)
    # Step 3: Start server with TLS config
    $COMPOSE up -d arca
    # Step 4: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 5: Run TLS-specific tests
    $COMPOSE --profile tls-test run --rm \
        -e ARCA_ENDPOINT=https://arca:9000 \
        -e AWS_CA_BUNDLE=/etc/arca/certs/arca-ca.crt \
        test integration/test_tls.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_tls
    return $rc
}

run_encryption() {
    echo "==> Running encryption integration tests..."

    enable_encryption
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_enc() {
        echo "Cleaning up encryption test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_enc EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start server with encryption config
    $COMPOSE up -d arca
    # Step 3: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 4: Run encryption-specific tests
    $COMPOSE run --rm \
        -e ARCA_ENCRYPTION_ENABLED=1 \
        test integration/test_encryption.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_enc
    return $rc
}

run_per_bucket_encryption() {
    echo "==> Running per-bucket encryption integration tests..."

    enable_encryption_per_bucket
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_pbe() {
        echo "Cleaning up per-bucket encryption test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_pbe EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start server with per-bucket encryption config (key present, enabled=false)
    $COMPOSE up -d arca
    # Step 3: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 4: Run per-bucket encryption tests
    $COMPOSE run --rm \
        -e ARCA_PER_BUCKET_ENCRYPTION=1 \
        test integration/test_per_bucket_encryption.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_pbe
    return $rc
}

run_kms() {
    echo "==> Running KMS integration tests..."

    enable_kms
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_kms() {
        echo "Cleaning up KMS test..."
        $COMPOSE --profile kms-init down -v 2>/dev/null || true
    }
    trap cleanup_kms EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start OpenBAO and wait for healthy
    $COMPOSE up -d openbao
    wait_for_openbao "$COMPOSE"
    # Step 3: Initialize KV v2 secrets (write master key, AppRole, etc.)
    $COMPOSE --profile kms-init run --rm openbao-init
    # Step 4: Start Arca with KMS config
    $COMPOSE up -d arca
    # Step 5: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 6: Run KMS-specific tests
    $COMPOSE run --rm \
        -e ARCA_KMS_ENABLED=1 \
        test integration/test_kms.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_kms
    return $rc
}

run_postgres() {
    echo "==> Running PostgreSQL backend integration tests..."

    enable_postgres
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_pg() {
        echo "Cleaning up PostgreSQL test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_pg EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start PostgreSQL and wait for healthy
    $COMPOSE up -d postgres
    wait_for_postgres "$COMPOSE"
    # Step 3: Start Arca with PostgreSQL config (migrations run at startup)
    $COMPOSE up -d arca
    # Step 4: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 5: Run PostgreSQL-specific tests
    $COMPOSE run --rm \
        -e ARCA_POSTGRES_BACKEND=1 \
        test integration/test_postgres.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_pg
    return $rc
}

run_presigned() {
    echo "==> Running presigned URL integration tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm test integration/test_presigned.py "$@"
}

run_ssec() {
    echo "==> Running SSE-C integration tests..."
    local COMPOSE
    COMPOSE="$(compose_cmd)"
    $COMPOSE run --rm test integration/test_ssec.py "$@"
}

run_notifications() {
    echo "==> Running notification integration tests..."

    enable_notifications
    build_config

    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_notif() {
        echo "Cleaning up notification test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_notif EXIT

    # Step 1: Build images
    $COMPOSE build arca webhook-receiver
    # Step 2: Start webhook receiver and Arca
    $COMPOSE up -d webhook-receiver
    $COMPOSE up -d arca
    # Step 3: Wait for services to be ready
    wait_for_arca "$COMPOSE"
    echo "Waiting for webhook receiver..."
    for i in $(seq 1 30); do
        if $COMPOSE exec -T webhook-receiver wget -q --spider http://localhost:8765/health 2>/dev/null; then
            echo "Webhook receiver ready"
            break
        fi
        sleep 1
    done
    # Step 4: Run notification tests
    $COMPOSE run --rm \
        -e WEBHOOK_RECEIVER_URL=http://webhook-receiver:8765 \
        test integration/test_notifications.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_notif
    return $rc
}

run_s3_compat() {
    echo "==> Running s3-tests compatibility suite..."
    exec "$(git rev-parse --show-toplevel)/bin/s3-tests" "$@"
}

case "${1:-all}" in
    unit)
        shift
        run_unit "$@"
        ;;
    integration)
        shift
        run_integration "$@"
        ;;
    tls)
        shift
        run_tls "$@"
        ;;
    encryption)
        shift
        run_encryption "$@"
        ;;
    per-bucket-encryption)
        shift
        run_per_bucket_encryption "$@"
        ;;
    kms)
        shift
        run_kms "$@"
        ;;
    postgres)
        shift
        run_postgres "$@"
        ;;
    presigned)
        shift
        run_presigned "$@"
        ;;
    ssec)
        shift
        run_ssec "$@"
        ;;
    notifications)
        shift
        run_notifications "$@"
        ;;
    s3-compat)
        shift
        run_s3_compat "$@"
        ;;
    all)
        run_unit
        echo ""
        run_integration
        ;;
    -h|--help)
        echo "Usage: bin/test <mode> [extra args...]"
        echo ""
        echo "Modes:"
        echo "  all                  Run unit + integration tests (default)"
        echo "  unit                 Run unit tests only"
        echo "  integration          Run integration tests only (server must be running)"
        echo "  tls                  Run TLS integration tests (self-contained)"
        echo "  encryption           Run encryption integration tests"
        echo "  per-bucket-encryption  Run per-bucket encryption tests"
        echo "  kms                  Run KMS integration tests (with OpenBAO)"
        echo "  postgres             Run PostgreSQL backend integration tests"
        echo "  presigned            Run presigned URL integration tests"
        echo "  ssec                 Run SSE-C integration tests"
        echo "  s3-compat            Run Ceph s3-tests compatibility suite"
        echo ""
        echo "Extra args are passed to the test runner (cargo test or pytest)."
        echo "Example: bin/test unit -p arca-core"
        exit 0
        ;;
    *)
        echo "Error: unknown test mode '$1'" >&2
        echo "Run 'bin/test --help' for available modes." >&2
        exit 1
        ;;
esac
