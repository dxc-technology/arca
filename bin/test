}

run_compression() {
    echo "==> Running compression integration tests..."

    # Compression is a console-only feature (no TOML fragment). The wrapper
    # is always installed at runtime — tests just need a plain Arca up.
    local COMPOSE
    COMPOSE="$(compose_cmd)"

    cleanup_comp() {
        echo "Cleaning up compression test..."
        $COMPOSE down -v 2>/dev/null || true
    }
    trap cleanup_comp EXIT

    $COMPOSE build arca
    $COMPOSE up -d arca
    wait_for_arca "$COMPOSE"
    $COMPOSE run --rm \
        test integration/test_compression.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_comp
    return $rc
}

