    }
    trap cleanup_enc EXIT

    # Step 1: Build images
    $COMPOSE build arca
    # Step 2: Start server with encryption config
    $COMPOSE up -d arca
    # Step 3: Wait for server to be ready
    wait_for_arca "$COMPOSE"
    # Step 4: Run encryption-specific tests
    $COMPOSE run --rm \
        -e ARCA_ENCRYPTION_ENABLED=1 \
        test integration/test_encryption.py "$@"
    local rc=$?

    trap - EXIT
    cleanup_enc
    return $rc
}

