#!/usr/bin/env bash
set -euo pipefail

# Run tests inside Docker.
#
# Usage:
#   bin/test              Run unit tests + integration tests
#   bin/test unit         Run unit tests only
#   bin/test integration  Run integration tests only (server must be running)
#   bin/test unit -p arca-core   Pass extra args to cargo test

cd "$(git rev-parse --show-toplevel)"

COMPOSE="docker compose -f docker/docker-compose.yml"
COMPOSE_TLS="docker compose -f docker/docker-compose.yml -f docker/docker-compose.tls.yml"

run_unit() {
    echo "==> Running unit tests..."
    $COMPOSE run --rm unit-test "$@"
}

run_integration() {
    echo "==> Running integration tests..."
    $COMPOSE run --rm test "$@"
}

run_tls() {
    echo "==> Running TLS integration tests..."
    # Step 1: Build images
    $COMPOSE_TLS --profile tls build
    # Step 2: Generate TLS certs (one-shot, separate profile)
    $COMPOSE_TLS --profile tls-init run --rm tls-init
    # Step 3: Start server with TLS config
    $COMPOSE_TLS --profile tls up -d
    # Step 4: Wait for server to be ready
    echo "Waiting for Arca TLS server..."
    for i in $(seq 1 30); do
        if $COMPOSE_TLS --profile tls exec -T arca /usr/local/bin/arca --help >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    sleep 2  # brief extra settle time
    # Step 5: Run TLS-specific tests
    $COMPOSE_TLS --profile tls run --rm test integration/test_tls.py "$@"
    local rc=$?
    # Step 6: Tear down
    $COMPOSE_TLS --profile tls --profile tls-init down -v
    return $rc
}

run_s3_compat() {
    echo "==> Running s3-tests compatibility suite..."
    exec "$(git rev-parse --show-toplevel)/bin/s3-tests" "$@"
}

case "${1:-all}" in
    unit)
        shift
        run_unit "$@"
        ;;
    integration)
        shift
        run_integration "$@"
        ;;
    tls)
        shift
        run_tls "$@"
        ;;
    s3-compat)
        shift
        run_s3_compat "$@"
        ;;
    all)
        run_unit
        echo ""
        run_integration
        ;;
    *)
        echo "Usage: bin/test [unit|integration|tls|s3-compat|all] [extra args...]" >&2
        exit 1
        ;;
esac
