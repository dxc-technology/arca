#!/usr/bin/env bash
set -euo pipefail

# Take automated screenshots of the Arca web console for documentation.
# Outputs PNG files to documentation/docs/assets/screenshots/.
#
# Uses the compose.sh library for consistent Docker Compose management.
# By default, starts Arca with encryption enabled so screenshots show
# encryption indicators (shield icons, badges, etc.).
#
# Usage:
#   bin/screenshots              Run screenshots (images must be built)
#   bin/screenshots --build      Rebuild all images first
#   bin/screenshots --no-encryption  Run without encryption features

cd "$(git rev-parse --show-toplevel)"
source bin/lib/compose.sh

BUILD=false
ENCRYPTION=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build)
            BUILD=true
            shift
            ;;
        --no-encryption)
            ENCRYPTION=false
            shift
            ;;
        -h|--help)
            echo "Usage: bin/screenshots [--build] [--no-encryption]"
            echo ""
            echo "Options:"
            echo "  --build           Rebuild all images (arca, console, screenshots) first"
            echo "  --no-encryption   Do not enable encryption (default: encryption ON)"
            echo ""
            echo "Outputs PNG files to documentation/docs/assets/screenshots/."
            exit 0
            ;;
        *)
            echo "Error: unknown option '$1'" >&2
            echo "Run 'bin/screenshots --help' for usage." >&2
            exit 1
            ;;
    esac
done

# Enable encryption by default for richer screenshots
if $ENCRYPTION; then
    enable_encryption
fi
build_config

COMPOSE="$(compose_cmd) --profile screenshots"

cleanup() {
    echo "==> Tearing down screenshot services..."
    $COMPOSE down --remove-orphans 2>/dev/null || true
    clean_env
}
trap cleanup EXIT

if $BUILD; then
    echo "==> Building images..."
    bin/build
    $COMPOSE build screenshots-console screenshots
fi

echo "==> Starting Arca server..."
$COMPOSE up -d arca

echo "==> Waiting for Arca health check..."
for i in $(seq 1 30); do
    if curl -sf http://localhost:9000/admin/health >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

echo "==> Starting console for screenshots..."
$COMPOSE up -d screenshots-console

echo "==> Running screenshot tool..."
$COMPOSE run --rm screenshots

echo "==> Screenshots complete."
ls -la documentation/docs/assets/screenshots/*.png 2>/dev/null || echo "Warning: no PNG files found"
