#!/usr/bin/env bash
set -euo pipefail

# Build documentation and commit+push to update GitHub Pages.

cd "$(git rev-parse --show-toplevel)"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: bin/docs-publish"
    echo ""
    echo "Build documentation and commit+push to update GitHub Pages."
    exit 0
elif [[ $# -gt 0 ]]; then
    echo "Error: unknown option '$1'" >&2
    echo "Run 'bin/docs-publish --help' for usage." >&2
    exit 1
fi

echo "==> Building docs..."
docker compose -f docker/docker-compose.docs.yml run --rm docs-build

if git diff --quiet docs/; then
    echo "==> No documentation changes to publish."
    exit 0
fi

echo "==> Committing and pushing docs..."
git add docs/
git commit -m "Rebuild documentation site"
git push

echo "==> Documentation published."
