#!/usr/bin/env bash
set -euo pipefail

# Run performance tests against a running Arca instance.
#
# Usage:
#   bin/perf-test                    Run with defaults
#   bin/perf-test --threads 20       Override thread count
#   bin/perf-test --build            Rebuild the perf image first

cd "$(git rev-parse --show-toplevel)"

COMPOSE="docker compose -f docker/docker-compose.yml --profile perf"
BUILD=false
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build)
            BUILD=true
            shift
            ;;
        -h|--help)
            echo "Usage: bin/perf-test [--build] [<args>]"
            echo ""
            echo "Options:"
            echo "  --build        Rebuild the perf-test image first"
            echo "  --threads N    Override thread count (passed to perf tool)"
            echo ""
            echo "Extra arguments are passed to the performance test tool."
            exit 0
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

if $BUILD; then
    echo "==> Building perf-test image..."
    $COMPOSE build perf-test
fi

echo "==> Running performance tests..."
$COMPOSE run --rm perf-test "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
