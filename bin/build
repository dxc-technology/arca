#!/usr/bin/env bash
set -euo pipefail

# Build the Arca Docker image.
#
# Usage:
#   bin/build          Build production image (FROM scratch, minimal)
#   bin/build --dev    Build development image (FROM debian:slim, has shell)

cd "$(git rev-parse --show-toplevel)"

for arg in "$@"; do
    case "$arg" in
        --dev)      export BUILD_TARGET=development ;;
        -h|--help)  echo "Usage: bin/build [--dev]"
                    echo ""
                    echo "Options:"
                    echo "  --dev  Build development image (debian-slim, has shell)"
                    exit 0 ;;
        *)          echo "Error: unknown option '$arg'" >&2
                    echo "Run 'bin/build --help' for usage." >&2
                    exit 1 ;;
    esac
done

echo "Building ${BUILD_TARGET:-production} image..."
docker compose -f docker/docker-compose.yml build arca
