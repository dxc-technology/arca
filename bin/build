#!/usr/bin/env bash
set -euo pipefail

# Build the Arca Docker image.
#
# Usage:
#   bin/build          Build production image (FROM scratch, minimal)
#   bin/build --dev    Build development image (FROM debian:slim, has shell)

cd "$(git rev-parse --show-toplevel)"

args=()
for arg in "$@"; do
    if [[ "$arg" == "--dev" ]]; then
        export BUILD_TARGET=development
    else
        args+=("$arg")
    fi
done

echo "Building ${BUILD_TARGET:-production} image..."
docker compose -f docker/docker-compose.yml build arca "${args[@]+"${args[@]}"}"
