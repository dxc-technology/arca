#!/usr/bin/env bash
set -euo pipefail

# Start the Arca server in Docker.
# Passes any extra flags to docker compose up (e.g. --build, -d).
#
# Usage:
#   bin/run --build -d         Start production image
#   bin/run --dev --build -d   Start development image (has shell)

cd "$(git rev-parse --show-toplevel)"

args=()
for arg in "$@"; do
    if [[ "$arg" == "--dev" ]]; then
        export BUILD_TARGET=development
    else
        args+=("$arg")
    fi
done

docker compose -f docker/docker-compose.yml up "${args[@]+"${args[@]}"}"
