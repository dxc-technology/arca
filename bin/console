#!/usr/bin/env bash
set -euo pipefail

# Manage the Arca web console container.
#
# Usage:
#   bin/console start                Start in foreground
#   bin/console start -d             Start in background
#   bin/console start -d --build     Start in background, rebuild image first
#   bin/console start --tls          Start with TLS overlay (no preset endpoint)
#   bin/console stop                 Stop the console
#   bin/console status               Show container status
#   bin/console logs                 Show logs
#   bin/console logs -f              Follow logs

cd "$(git rev-parse --show-toplevel)"

COMPOSE="docker compose -f docker/docker-compose.yml --profile console"

usage() {
    echo "Usage: bin/console <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start [-d] [--build] [--tls]   Start the web console"
    echo "  stop                            Stop the web console"
    echo "  status                          Show container status"
    echo "  logs [-f]                       Show console logs"
    echo ""
    echo "Options:"
    echo "  -d         Run in background (detached)"
    echo "  --build    Rebuild the Docker image before starting"
    echo "  --tls      TLS mode (clears preset endpoint, shows URL field at login)"
    echo "  -f         Follow log output"
    exit 0
}

cmd_start() {
    local detach=false
    local build=false
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d)       detach=true; shift ;;
            --build)  build=true; shift ;;
            --tls)    COMPOSE="docker compose -f docker/docker-compose.yml -f docker/docker-compose.tls.yml --profile console"; shift ;;
            *)        echo "Unknown option: $1" >&2; usage ;;
        esac
    done

    if $build; then
        echo "Building console image..."
        $COMPOSE build console
    fi

    if $detach; then
        args+=("-d")
    fi

    $COMPOSE up "${args[@]+"${args[@]}"}" console
}

cmd_stop() {
    $COMPOSE down "$@"
}

cmd_status() {
    $COMPOSE ps console
}

cmd_logs() {
    local follow=false
    local args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f)  follow=true; shift ;;
            *)   echo "Unknown option: $1" >&2; usage ;;
        esac
    done

    if $follow; then
        args+=("-f")
    fi

    $COMPOSE logs "${args[@]+"${args[@]}"}" console
}

[[ $# -lt 1 ]] && usage

command="$1"
shift

case "$command" in
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    status)  cmd_status "$@" ;;
    logs)    cmd_logs "$@" ;;
    -h|--help) usage ;;
    *)       echo "Unknown command: $command" >&2; usage ;;
esac
