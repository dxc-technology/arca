#!/usr/bin/env bash
set -euo pipefail

# Start the Arca web console in Docker.
# Passes any extra flags to docker compose up (e.g. --build, -d).
#
# Usage:
#   bin/console --build -d     Start console (builds image first)
#   bin/console -d             Start console in background

cd "$(git rev-parse --show-toplevel)"

docker compose -f docker/docker-compose.yml --profile console up console "$@"
