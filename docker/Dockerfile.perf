FROM python:3.12-slim

RUN pip install --no-cache-dir boto3

WORKDIR /tests
COPY tests/perf/perf_test.py .

RUN useradd --no-create-home --shell /usr/sbin/nologin tester && \
    chown -R tester:tester /tests

USER tester

# A short-lived command runner, not a service: there is nothing to probe.
HEALTHCHECK NONE

ENTRYPOINT ["python", "perf_test.py"]
